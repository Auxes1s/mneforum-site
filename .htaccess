Options -Indexes
DirectoryIndex index.html

# HTML and route metadata must update immediately after a release. Stylesheets
# are linked with a release query string, while the remaining local assets are
# release-stable and can be cached without rebuilding the document.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:html?|webmanifest)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:svg|png|jpe?g|webp|avif|woff2?|ttf)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # The preserved original page mounts an inline, blob-backed runtime and
    # loads its approved external runtime/font resources. Keep the safer
    # response headers above; a strict CSP belongs in a future bundle rewrite.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

RewriteEngine On

# The development preview resolves to the same preserved bundled page while
# keeping /dev available as a staging-only route.
RewriteRule ^dev/$ /dev [R=301,END]
RewriteRule ^dev$ index.html [END]

# Registration and form shortlinks go straight to their current providers.
# Keep these temporary so a changed form URL can be corrected without a
# permanently cached redirect.
RewriteRule ^register/?$ https://docs.google.com/forms/d/e/1FAIpQLSfPj5AaCY1EGU6OsxfZWNB6E6AsYeuNix9hmrrvBJfhyuQbSw/viewform?usp=header [R=302,END,NE]
RewriteRule ^dro-register/?$ https://forms.gle/dwqog8oEkqnNUXqU8 [R=302,END,NE]
RewriteRule ^rp-register/?$ https://docs.google.com/forms/d/e/1FAIpQLScULCsJGfhJyCg14w9g34CTtLkbp9Kvhx-8S0DoJ0pgo2_TyA/viewform [R=302,END,NE]
RewriteRule ^evalform/?$ https://forms.office.com/pages/responsepage.aspx?id=zITAUhXNcUaKV8GVZbzfwhLmvB3coLdNjeQZqbXaWg5UQ09PR0lTMURMQzQ2N1FVT0tOMVYwMkNFSi4u&route=shorturl [R=302,END,NE]
RewriteRule ^eg-submission/?$ https://drive.google.com/drive/folders/1EJFDxDgp_Q5tlzz6im742qdg_6zduvkt?usp=sharing [R=302,END,NE]

# These 2025 routes are retired from the production tree. The signed participant
# flow URL was time-bound and must not be kept as a stale redirect.
RewriteRule ^archive(?:/|$) - [G,L]
RewriteRule ^participantflow(?:/|$) - [G,L]

# Stable working documents remain external until they are replaced by verified
# first-party pages.
RewriteRule ^logistics-note/?$ https://drive.google.com/drive/folders/1U1WHCzctKs1GzAYG8-2x6fwBG2Dj5VM-?usp=drive_link [R=301,END,NE]
RewriteRule ^agenda/?$ https://drive.google.com/drive/folders/1okuWWAQQ5pTnVbO26m1uAFtmRxBYWmso?usp=drive_link [R=301,END,NE]

# Development subdomain support when the host is configured with this directory
# as its document root.
RewriteCond %{HTTP_HOST} ^dev\.mnenetwork\.forum(?::\d+)?$ [NC]
RewriteRule ^$ index.html [END]
